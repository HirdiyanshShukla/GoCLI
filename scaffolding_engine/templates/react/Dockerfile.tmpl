# Stage 1: Build the React application
FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci --silent
COPY . .
# Normalize output folder for Vite (dist) and CRA (build)
RUN npm run build && \
    if [ -d "build" ] && [ ! -d "dist" ]; then mv build dist; fi

# Stage 2: Serve with Nginx
FROM nginx:alpine
# Hardcode UID/GID to 1000 to match Kubernetes securityContext
RUN apk add --no-cache curl && \
    sed -i 's/80/{{ .app_port }}/g' /etc/nginx/conf.d/default.conf && \
    addgroup -g 1000 -S appgroup && adduser -u 1000 -S appuser -G appgroup && \
    touch /var/run/nginx.pid && \
    chown -R appuser:appgroup \
        /usr/share/nginx/html \
        /var/cache/nginx \
        /var/log/nginx \
        /etc/nginx/conf.d \
        /var/run/nginx.pid

# Satisfy Checkov Security Scanner (Ignored by K8s, used by pure Docker)
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD curl --fail http://localhost:{{ .app_port }}/ || exit 1

USER appuser

COPY --from=build --chown=appuser:appgroup /app/dist /usr/share/nginx/html

EXPOSE {{ .app_port }}
CMD ["nginx", "-g", "daemon off;"]