FROM python:{{ .python_version }}-slim

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# 🔒 Checkov standard: Never run as root!
RUN useradd -m appuser && chown -R appuser /app
USER appuser

# Satisfy Checkov Security Scanner intelligently
{{- if .health_path }}
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl --fail http://localhost:{{ .app_port }}{{ .health_path }} || exit 1
{{- else }}
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD bash -c 'echo > /dev/tcp/localhost/{{ .app_port }}' || exit 1
{{- end }}

EXPOSE {{ .app_port }}

# 🚀 Dynamic execution based on environment
CMD {{ .run_command }}
